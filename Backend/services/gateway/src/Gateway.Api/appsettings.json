{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "unillanos-usuarios",
    "Audience": "unillanos-notas"
  },
  "ReverseProxy": {
    "Routes": {
      "login": {
        "ClusterId": "usuarios",
        "AuthorizationPolicy": "publico",
        "CorsPolicy": "frontend",
        "Order": 0,
        "Match": { "Path": "/auth/login" }
      },
      "auth": {
        "ClusterId": "usuarios",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/auth/{**resto}" }
      },
      "evaluaciones-cursos": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/cursos/{**resto}" }
      },
      "evaluaciones-cursos-raiz": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/cursos" }
      },
      "evaluaciones-mis-notas": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/mis-notas/{**resto}" }
      },
      "evaluaciones-mis-notas-raiz": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/mis-notas" }
      },
      "evaluaciones-actividad": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/actividades/{id}" }
      },
      "evaluaciones-calificaciones": {
        "ClusterId": "evaluaciones",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/actividades/{id}/calificaciones/{**resto}" }
      },
      "entregas-de-actividad": {
        "ClusterId": "entregas",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/actividades/{id}/entregas" }
      },
      "entregas": {
        "ClusterId": "entregas",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/entregas/{**resto}" }
      },
      "entregas-propias": {
        "ClusterId": "entregas",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Order": 1,
        "Match": { "Path": "/mis-entregas" }
      }
    },
    "Clusters": {
      "usuarios": { "Destinations": { "principal": { "Address": "http://localhost:5001/" } } },
      "evaluaciones": { "Destinations": { "principal": { "Address": "http://localhost:5002/" } } },
      "entregas": { "Destinations": { "principal": { "Address": "http://localhost:5003/" } } }
    }
  }
}
