# Copie este archivo a infra/.env (ignorado por git) y cambie los valores.
# No contiene secretos reales: son marcadores para desarrollo local.

# Contraseña del usuario sa de SQL Server (mín. 8 caracteres, mayúscula, minúscula, número y símbolo).
SQL_SA_PASSWORD=CambieEsta_Clave1

# Llave compartida para la llamada interna Entregas -> Evaluaciones (X-Service-Key). Mínimo 16 caracteres.
SERVICE_KEY=cambie-esta-llave-de-servicio-local
