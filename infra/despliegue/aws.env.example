# Copie este archivo a infra/despliegue/.env en el servidor (ignorado por git) y cambie los valores.

# URL pública del sitio SIN barra final. Con IP: http://IP_ELASTICA. Con dominio: https://notas.midominio.com
PUBLIC_URL=http://IP_ELASTICA

# ":80" para HTTP por IP. Con dominio apuntando al servidor: notas.midominio.com (Caddy saca el certificado solo).
SITE_ADDRESS=:80

# Contraseña de sa de SQL Server (mín. 8, mayúscula, minúscula, número y símbolo).
SQL_SA_PASSWORD=CambieEsta_Clave1
# Memoria máxima de SQL Server en MB (1024 para una instancia de 2 GB).
SQL_MEMORY_MB=1024

# Resultado de: id -u  y  id -g  (el servicio de usuarios lee la llave privada con ese UID).
HOST_UID=1000
HOST_GID=1000

# Llave interna Entregas -> Evaluaciones (mín. 16 caracteres). Genere una: openssl rand -hex 24
SERVICE_KEY=cambie-esta-llave-de-servicio-local

# Asistente IA (Groq). Sin llave solo el asistente no arranca; el resto funciona.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=pon-aqui-tu-llave-de-groq
LLM_MODEL=openai/gpt-oss-20b
