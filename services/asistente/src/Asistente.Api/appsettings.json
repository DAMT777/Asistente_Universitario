{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "unillanos-usuarios",
    "Audience": "unillanos-notas",
    "ClockSkewSegundos": 0
  },
  "Llm": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "TimeoutSeconds": 15
  },
  "Services": {
    "GatewayTimeoutSeconds": 10
  },
  "Asistente": {
    "ExpiracionAccionMinutos": 5,
    "MaxLlamadasHerramientas": 5,
    "MensajesPorMinuto": 10,
    "MaxCaracteresMensaje": 1000
  },
  "Database": {
    "AplicarMigraciones": false
  }
}
