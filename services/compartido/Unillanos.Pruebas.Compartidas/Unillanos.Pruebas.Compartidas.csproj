<Project Sdk="Microsoft.NET.Sdk">
  <!-- Soporte común de pruebas (no contiene pruebas):
       - Contratos: lee contracts/*.yaml y valida respuestas JSON contra sus esquemas, sin librerías externas.
       - Seguridad: par de llaves RSA efímero y emisión de JWT RS256 de prueba.
       - RelojFijo: TimeProvider controlable para las reglas de fecha límite. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\contracts\*.yaml" Link="contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
